# Custom domain once DNS is ready (https://www.example.com). Optional before that:
# on Vercel the *.vercel.app production URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Where booking requests are forwarded as JSON (Google Apps Script, Zapier, Make, Slack relay...).
# Without it, requests are only logged in development and rejected with 503 in production.
BOOKING_WEBHOOK_URL=
